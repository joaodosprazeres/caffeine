# Variáveis usadas pelo docker-compose.yml (copie para .env e ajuste se necessário)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=caffeine

JWT_SECRET=dev-only-secret-troque-em-producao
CORS_ALLOW_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=5

# URL que o navegador usa para chamar a API — embutida no build do frontend
VITE_API_BASE_URL=http://localhost:8000/api
